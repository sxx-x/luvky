{
  "name": "podcast-together",
  "version": "0.10.4",
  "description": "一个基于 vite + vue + vue-router + ts + laf 的全栈项目，让你跟好友一起实时在线听播客！",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev-force": "node scripts/dev-local.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node local-server/index.mjs",
    "dev:vite": "vite",
    "dev:local": "node scripts/dev-local.mjs",
    "server": "node local-server/index.mjs",
    "test": "node --test local-server/session.test.mjs local-server/parse-text.test.mjs local-server/smoke-test.mjs local-server/cover-edge.test.mjs",
    "test:sync": "node --test local-server/session.test.mjs local-server/parse-text.test.mjs local-server/smoke-test.mjs local-server/cover-edge.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "nanoid": "^5.0.7",
    "pinia": "^3.0.3",
    "shikwasa2": "^2.3.0",
    "vconsole": "^3.15.1",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "weixin-js-sdk-ts": "^1.6.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "puppeteer-core": "^25.17.0",
    "sass": "^1.74.1",
    "typescript": "^5.4.4",
    "user-agent-data-types": "^0.4.2",
    "vite": "^7.1.5",
    "vite-plugin-mkcert": "^1.17.5",
    "vite-plugin-pwa": "^1.0.3",
    "vue-tsc": "^3.0.7"
  },
  "author": "yenche123 <tsuiyenche@outlook.com> (https://github.com/yenche123)",
  "contributors": [],
  "keywords": [
    "podcast",
    "播客",
    "vue",
    "web-socket",
    "shikwasa",
    "typescript",
    "laf",
    "一起听播客",
    "实时连线"
  ],
  "license": "MIT",
  "repository": "github:yenche123/podcast-together"
}
